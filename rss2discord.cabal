cabal-version: 2.4
name: rss2discord
version: 0.3.0.1
license: AGPL-3.0-only
license-file: LICENSE
build-type: Simple

executable rss2discord
  main-is: Main.hs
  other-modules: DiscordWebhook, Feed, FeedConfig, History, Paths_rss2discord
  autogen-modules: Paths_rss2discord
  default-language: GHC2024
  ghc-options: -Wall -threaded
  build-depends:
    base >=4.14 && <5,
    aeson,
    bytestring,
    cassava,
    containers,
    directory,
    feed,
    http-client,
    http-client-tls,
    http-types,
    monad-logger,
    persistent,
    persistent-sqlite,
    safe-exceptions,
    text,
    transformers,
    unix
