cabal-version: 2.4
name: rss2discord
version: 0.1.0.0
license: AGPL-3.0-only
license-file: LICENSE
build-type: Simple

executable rss2discord
  main-is: Main.hs
  other-modules: DiscordWebhook, Paths_rss2discord
  autogen-modules: Paths_rss2discord
  default-language: Haskell2010
  ghc-options: -Wall -threaded
  build-depends:
    base >=4.14 && <5,
    aeson,
    bytestring,
    cassava,
    containers,
    directory,
    feed,
    filepath,
    http-client,
    http-client-tls,
    http-types,
    safe-exceptions,
    text
